---
// Layout base — envolve todas as páginas do site.
// Fontes locais. latin traz A-Z; latin-ext traz os acentos e o cedilha.
// Os dois são necessários: latin-ext sozinho não cobre as letras comuns.
// As duas fontes acima da dobra entram com preload, para chegarem antes da
// primeira pintura. Sem isso o texto pisca: aparece no fallback e troca.
// O import resolve o hash do arquivo a cada build — caminho fixo quebraria.
import bebasWoff from '@fontsource/bebas-neue/files/bebas-neue-latin-400-normal.woff2?url';
import interWoff from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';

import '@fontsource/bebas-neue/latin-400.css';
import '@fontsource/bebas-neue/latin-ext-400.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-ext-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '@fontsource/ibm-plex-mono/latin-ext-500.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-ext-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-ext-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-ext-600.css';
import '@fontsource/inter/latin-700.css';
import '@fontsource/inter/latin-ext-700.css';
import '../styles/tokens.css';
import '../styles/base.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Analytics from '../components/layout/Analytics.astro';

interface Props {
  titulo: string;
  descricao: string;
  /** Imagem de compartilhamento. Caminho a partir de public/ */
  imagemOg?: string;
}

const { titulo, descricao, imagemOg = '/og/padrao.jpg' } = Astro.props;

// URL canônica desta página, montada a partir do `site` do astro.config.mjs
const canonica = new URL(Astro.url.pathname, Astro.site);
const urlOg = new URL(imagemOg, Astro.site);
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <!-- Fontes acima da dobra, com prioridade alta. Sem isso o texto aparece
       no fallback e troca quando o arquivo chega — a tela pisca. -->
  <link rel="preload" as="font" type="font/woff2" href={bebasWoff} crossorigin />
  <link rel="preload" as="font" type="font/woff2" href={interWoff} crossorigin />

  <title>{titulo}</title>
  <meta name="description" content={descricao} />
  <link rel="canonical" href={canonica} />
  <meta name="theme-color" content="#0A0A0A" />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={titulo} />
  <meta property="og:description" content={descricao} />
  <meta property="og:image" content={urlOg} />
  <meta property="og:url" content={canonica} />
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <Analytics />

  <!-- Bebas Neue (títulos) · Inter (texto) · IBM Plex Mono (dados técnicos) -->
  <!-- Fontes servidas pelo próprio site. Nada é buscado no Google. -->
</head>
<body>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />

  <script>
    import '../scripts/menu.js';
    import '../scripts/reveal.js';
    import '../scripts/parallax.js';
    import '../scripts/inclinar.js';
  </script>
</body>
</html>