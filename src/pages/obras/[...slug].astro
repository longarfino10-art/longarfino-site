---
// Página individual de cada obra. Uma rota por arquivo .md da coleção.

import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import FichaTecnica from '../../components/obras/FichaTecnica.astro';
import Trilha from '../../components/layout/Trilha.astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const obras = await getCollection('obras');
  return obras.map((obra) => ({
    params: { slug: obra.id },
    props: { obra },
  }));
};

const { obra } = Astro.props;
const { Content } = await render(obra);
const d = obra.data;
---

<Base
  titulo={`${d.nome} — Longarfino Skateparks`}
  descricao={d.descricao_curta ?? `Skatepark em ${d.cidade}/${d.uf}, ${d.area_m2} m².`}
>
  <Trilha itens={[{ nome: 'Obras', href: '/obras' }, { nome: d.nome }]} />

  <article class="obra">
    <!-- Cabeçalho: título grande à esquerda, ficha técnica à direita -->
    <header class="obra-topo sec">
      <div>
        <span class="eyebrow">
          {d.cidade} / {d.uf}
          {d.status === 'em_execucao' && ' · Em execução'}
        </span>

        <h1 class="d h-sec">{d.nome}</h1>

        {d.descricao_curta && (
          <p class="lead" style="margin-top:24px">{d.descricao_curta}</p>
        )}
      </div>

      <div class="obra-ficha">
        <FichaTecnica obra={d} />
      </div>
    </header>

    <!-- Capa em largura total -->
    <figure class="ph obra-capa">
      <Image
        src={d.capa}
        alt={`Vista da obra ${d.nome}`}
        widths={[800, 1400, 2000]}
        sizes="100vw"
        loading="eager"
      />
    </figure>

    <!-- Estudo de caso -->
    <div class="sec obra-texto">
      <div class="prosa">
        <Content />
      </div>
    </div>

    <!-- Galeria da obra -->
    {d.fotos.length > 0 && (
      <section class="sec obra-fotos">
        <span class="eyebrow">Registro da obra</span>
        <div class="obra-grade">
          {d.fotos.map((foto, i) => (
            <figure class="ph">
              <Image
                src={foto}
                alt={`${d.nome} — foto ${i + 1}`}
                widths={[600, 1200]}
                sizes="(max-width: 860px) 100vw, 50vw"
                loading="lazy"
              />
            </figure>
          ))}
        </div>
      </section>
    )}

    <!-- Volta ao portfólio logo ao fim das fotos, antes do CTA comercial.
         Quem quer ver outra obra não precisa passar pelo pedido de orçamento. -->
    <div class="sec obra-volta">
      <a class="btn" href="/obras">Ver outras obras <i class="arw"></i></a>
    </div>

    <!-- Chamada final -->
    <section class="sec obra-cta">
      <h2 class="d h-sec">Vamos tirar o<br />projeto do papel<span class="ponto">?</span></h2>
      <div class="obra-cta-acoes">
        <a class="btn btn--fill" href="/contato">Solicitar orçamento <i class="arw"></i></a>
      </div>
    </section>
  </article>
</Base>

<style>
  /* O header fixo cobre o topo — o primeiro bloco precisa de folga */
  .obra-topo {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: clamp(32px, 5vw, 90px);
    align-items: end;
    padding-top: clamp(120px, 12vw, 170px);
    padding-bottom: clamp(40px, 5vw, 72px);
  }

  /* A ficha acompanha a base da coluna de texto */
  .obra-ficha { align-self: end; padding-bottom: 4px }

  .obra-capa {
    aspect-ratio: 16 / 9;
    margin-inline: var(--pad);
  }

  .obra-texto { padding-block: clamp(56px, 7vw, 96px) }

  /* Coluna de leitura estreita — texto largo cansa */
  .prosa {
    max-width: 62ch;
    font-size: clamp(16px, 1.15vw, 18px);
    color: var(--gray-200);
  }
  .prosa :global(p + p) { margin-top: 1.2em }
  .prosa :global(h2) {
    font-family: var(--ff-display);
    font-weight: 400;
    font-size: clamp(1.6rem, 2.4vw, 2.4rem);
    line-height: 1;
    text-transform: uppercase;
    color: var(--white);
    margin: 1.8em 0 .6em;
  }

  .obra-fotos { padding-top: 0 }
  .obra-volta { padding-block: clamp(20px, 2.4vw, 32px) }

  .obra-grade {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(14px, 1.8vw, 30px);
  }
  .obra-grade .ph { aspect-ratio: 4 / 3 }
  /* A primeira foto ocupa a largura toda, quebrando o ritmo da grade */
  .obra-grade .ph:first-child { grid-column: span 2; aspect-ratio: 16 / 9 }

  .obra-cta { border-top: 1px solid var(--line) }
  .obra-cta h2 { color: var(--white) }
  .ponto { color: var(--orange) }
  .obra-cta-acoes {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 36px;
  }

  @media (max-width: 980px) {
    .obra-topo { grid-template-columns: 1fr; align-items: start }
    .obra-ficha { margin-top: 8px }
    .obra-grade { grid-template-columns: 1fr }
    .obra-grade .ph:first-child { grid-column: span 1 }
  }
</style>