---
// Confirmação de envio do formulário. O Web3Forms redireciona para cá depois
// de aceitar o pedido.
//
// Serve também de destino de conversão no GA4: basta criar um evento a partir
// de page_view com page_location contendo /obrigado.
//
// O check é traçado em SVG, na espessura das linhas técnicas do site. Não é
// ícone de biblioteca — é desenho, como o resto.
import Base from '../layouts/Base.astro';
import Desenhos from '../components/ui/Desenhos.astro';

const WHATSAPP = 'https://wa.me/5551986245321';
---

<Base
  titulo="Pedido enviado — Longarfino Skateparks"
  descricao="Recebemos seu pedido de orçamento."
>
  <Desenhos />

  <section class="sec ob">
    <svg class="ob-check" viewBox="0 0 64 64" width="64" height="64" fill="none" aria-hidden="true">
      <circle class="ob-circ" cx="32" cy="32" r="30" fill="none" stroke="#E85A24" stroke-width="2" />
      <path class="ob-risco" d="M19 33.5 L28.5 43 L45 24" fill="none" stroke="#E85A24" stroke-width="2" stroke-linecap="square" />
    </svg>

    <span class="eyebrow ob-eb">Pedido enviado</span>
    <h1 class="d h-sec ob-h">Recebemos<span class="ob-ponto">.</span></h1>
    <p class="lead ob-p">
      Seu pedido chegou. A equipe responde em até dois dias úteis, no e-mail ou
      no telefone que você informou.
    </p>
    <p class="lead ob-p">
      Se for urgente, chame no WhatsApp — costuma ser mais rápido.
    </p>

    <div class="ob-acoes">
      <a href={WHATSAPP} target="_blank" rel="noopener" class="btn btn--fill">
        Chamar no WhatsApp <span class="arw"></span>
      </a>
      <a href="/obras" class="btn">Ver obras <span class="arw"></span></a>
      <a href="/" class="btn">Voltar ao início <span class="arw"></span></a>
    </div>
  </section>
</Base>

<style>
  /* Fim de fluxo: sem navegação, sem leitura longa. O bloco vai ao centro,
     senão sobra dois terços de tela vazia à direita. */
  .ob {
    min-height: 62vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding-top: clamp(90px, 9vw, 130px);
  }
  .ob > * { max-width: 54ch }

  /* O círculo se fecha, depois o risco se traça. Ordem importa: o gesto
     imita quem desenha à mão. */
  .ob-check {
    width: clamp(52px, 5vw, 68px);
    height: auto;
    display: block;
    margin: 0 auto clamp(22px, 2.6vw, 32px);
    overflow: visible;
  }
  .ob-circ,
  .ob-risco {
    fill: none;
    stroke: var(--orange);
    stroke-width: 2;
    stroke-linecap: square;
    stroke-linejoin: miter;
  }
  .ob-circ {
    stroke-dasharray: 189;
    stroke-dashoffset: 189;
    transform: rotate(-90deg);
    transform-origin: center;
    animation: traca-circ .7s cubic-bezier(.22, .61, .36, 1) forwards;
  }
  .ob-risco {
    stroke-dasharray: 40;
    stroke-dashoffset: 40;
    animation: traca-risco .34s cubic-bezier(.22, .61, .36, 1) .52s forwards;
  }
  @keyframes traca-circ { to { stroke-dashoffset: 0 } }
  @keyframes traca-risco { to { stroke-dashoffset: 0 } }

  /* Texto entra depois do desenho, em escada. */
  .ob-eb,
  .ob-h,
  .ob-p,
  .ob-acoes {
    opacity: 0;
    animation: sobe .5s cubic-bezier(.22, .61, .36, 1) forwards;
  }
  .ob-eb { animation-delay: .78s }
  .ob-h { animation-delay: .86s }
  .ob-p:nth-of-type(1) { animation-delay: .94s }
  .ob-p:nth-of-type(2) { animation-delay: 1.02s }
  .ob-acoes { animation-delay: 1.1s }
  @keyframes sobe {
    from { opacity: 0; transform: translateY(12px) }
    to   { opacity: 1; transform: none }
  }

  .ob-h { color: var(--white); margin: 12px 0 22px }
  .ob-ponto { color: var(--orange) }
  .ob-p + .ob-p { margin-top: 14px }
  .ob-acoes {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: clamp(28px, 3.2vw, 40px);
  }
  /* A seta cresce de 26 para 38px no hover. Centralizado, isso empurra os
     botões vizinhos. Reservar a largura final desde o início trava o layout. */
  .ob-acoes .arw { width: 38px }

  /* Quem pediu menos movimento no sistema recebe a página pronta. */
  @media (prefers-reduced-motion: reduce) {
    .ob-circ, .ob-risco { stroke-dashoffset: 0; animation: none }
    .ob-eb, .ob-h, .ob-p, .ob-acoes { opacity: 1; animation: none }
  }
</style>