---
// Biblioteca de desenhos técnicos em SVG.
// Este componente injeta os <symbol> uma única vez no início do <body>.
// Para usar um desenho em qualquer lugar: <Desenho id="dwg-bowl3d" />
//
// Os traços usam vector-effect="non-scaling-stroke", então a linha fica com
// 1px real em qualquer tamanho que o desenho for exibido.
//
// Os desenhos com sufixo "-cota" são os da seção de Serviços: têm medida
// real escrita e por isso pedem opacidade mais alta (0.4) para o número
// ficar legível. Os sem sufixo são marca d'água, entre 0.08 e 0.16.
---

<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">

  <!-- 01 · Levantamento topográfico: curvas de nível -->
  <symbol id="dwg-contours" viewBox="0 0 200 120">
    <g fill="none" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke">
      <ellipse cx="98" cy="58" rx="80" ry="41" transform="rotate(-7 98 58)" />
      <ellipse cx="98" cy="58" rx="62" ry="31" transform="rotate(-7 98 58)" />
      <ellipse cx="98" cy="58" rx="44" ry="21" transform="rotate(-7 98 58)" />
      <ellipse cx="98" cy="58" rx="25" ry="11" transform="rotate(-7 98 58)" />
      <path d="M98 44v28M84 58h28" stroke-dasharray="3 3" />
      <path d="M6 112h188" stroke-dasharray="7 5" opacity=".55" />
      <path d="M20 6v10M14 11h12M176 100v10M170 105h12" />
    </g>
  </symbol>

  <!-- 02 · Projeto: planta baixa com bowl, ledges e escada -->
  <symbol id="dwg-plan" viewBox="0 0 200 120">
    <g fill="none" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke">
      <rect x="8" y="8" width="184" height="94" />
      <path d="M8 34h184M8 76h184M62 8v94M132 8v94" stroke-dasharray="2 5" opacity=".45" />
      <rect x="24" y="30" width="82" height="52" rx="26" />
      <rect x="34" y="40" width="62" height="32" rx="16" />
      <path d="M124 22h52M124 22v8h52v-8M124 44h38v7h-38z" />
      <path d="M126 66h10v6h10v6h10v6h10v6h12" />
      <path d="M8 112h184M8 108v8M192 108v8" />
    </g>
  </symbol>

  <!-- 03 · Preparação: corte de escavação com taludes -->
  <symbol id="dwg-earth" viewBox="0 0 200 120">
    <g fill="none" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke">
      <path d="M4 44h48l26 40h44l26-40h48" />
      <path d="M4 44h192" stroke-dasharray="4 4" opacity=".45" />
      <path d="M60 92l8-8M76 100l14-14M96 100l14-14M116 100l12-12M136 96l8-8" />
      <path d="M40 44v-16M36 28h8l-4 6zM160 44V28M156 28h8l-4 6z" />
      <path d="M4 108h192M4 104v8M196 104v8" />
    </g>
  </symbol>

  <!-- 04 · Execução: malha de armação em perspectiva -->
  <symbol id="dwg-rebar" viewBox="0 0 200 120">
    <g fill="none" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke">
      <path d="M10 96L86 30M32 100L108 34M54 104L130 38M76 108L152 42M98 112L174 46" />
      <path d="M10 96L98 112M20 87L108 103M30 78L118 94M40 69L128 85M50 60L138 76M60 51L148 67M70 42L158 58M80 33L168 49" />
      <path d="M86 30L174 46" opacity=".5" />
      <path d="M10 96v10M98 112v6" stroke-dasharray="3 3" opacity=".5" />
    </g>
  </symbol>

  <!-- 05 · Acabamento: detalhe de coping com raio cotado -->
  <symbol id="dwg-coping" viewBox="0 0 200 120">
    <g fill="none" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke">
      <path d="M12 100h44A56 56 0 0 1 112 44V26h76" />
      <path d="M12 110h44A66 66 0 0 1 122 44V36h66" opacity=".55" />
      <circle cx="112" cy="32" r="7" />
      <path d="M56 100L56 44 112 44" stroke-dasharray="4 4" opacity=".6" />
      <path d="M64 108l6-6M80 110l8-8M98 106l7-7" />
      <path d="M130 26h58M130 22v8M188 22v8" opacity=".7" />
    </g>
  </symbol>

  <!-- 06 · Entrega: bowl em perspectiva -->
  <symbol id="dwg-bowl3d" viewBox="0 0 200 120">
    <g fill="none" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke">
      <path d="M40 40h86a48 26 0 0 1 0 52H40a48 26 0 0 1 0-52z" />
      <path d="M56 54h70a30 16 0 0 1 0 32H56a30 16 0 0 1 0-32z" />
      <path d="M40 40l16 14M126 40l-1 14M40 92l16-6M126 92l-1-6" opacity=".7" />
      <path d="M14 30h172" stroke-dasharray="4 4" opacity=".4" />
      <path d="M150 66h32M150 62v8M182 62v8" opacity=".7" />
    </g>
  </symbol>

  <!-- ================================================================
       DESENHOS COTADOS · seção Serviços
       Medidas de referência: quarter h 1200 / R 2100, coping Ø60,
       ledge 400, escada 1200, laje 120 com junta a 1/3 e malha a
       meia altura. A espessura de 120 é valor escolhido dentro da
       faixa usual — CONFERIR com o Lucas antes do lançamento.
       ================================================================ -->

  <!-- 01 Projeto: planta cotada com bowl, ledge e escada -->
  <symbol id="dwg-projeto-cota" viewBox="0 0 200 120">
    <g fill="none" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke">
      <rect x="14" y="14" width="150" height="72" />
      <path d="M14 50h150M89 14v72" stroke-dasharray="3 7" opacity=".35" />
      <ellipse cx="55" cy="50" rx="29" ry="21" />
      <ellipse cx="55" cy="50" rx="18" ry="12" />
      <rect x="100" y="24" width="46" height="9" />
      <path d="M104 60h10v6h10v6h10v6h10" />
      <path d="M14 96h150M14 92v8M164 92v8M89 92v8" opacity=".7" />
      <path d="M176 14v72M172 14h8M172 86h8" opacity=".7" />
      <text x="28" y="110" style="font-family:var(--ff-mono);font-size:8px"
            fill="currentColor" stroke="none">18000</text>
      <text x="110" y="110" style="font-family:var(--ff-mono);font-size:8px"
            fill="currentColor" stroke="none">12000</text>
    </g>
  </symbol>

  <!-- 02 Concreto: corte da laje. Malha a meia altura, junta serrada a 1/3 -->
  <symbol id="dwg-laje-cota" viewBox="0 0 200 120">
    <g fill="none" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke">
      <path d="M12 56h146M12 80h146" />
      <path d="M12 56v24M158 56v24" />
      <path d="M12 96h146" opacity=".5" />
      <path d="M12 80v16M158 80v16" opacity=".5" />
      <path d="M18 96l7-9M32 96l7-9M46 96l7-9M60 96l7-9M74 96l7-9M88 96l7-9M102 96l7-9M116 96l7-9M130 96l7-9M144 96l7-9" opacity=".45" />
      <path d="M18 68h134" stroke-dasharray="1 6" opacity=".6" />
      <circle cx="34" cy="68" r="1.5" /><circle cx="62" cy="68" r="1.5" /><circle cx="90" cy="68" r="1.5" /><circle cx="118" cy="68" r="1.5" />
      <path d="M96 56v8" />
      <path d="M172 56v24M168 56h8M168 80h8" opacity=".7" />
      <text x="162" y="48" style="font-family:var(--ff-mono);font-size:8px"
            fill="currentColor" stroke="none">120</text>
      <text x="84" y="50" style="font-family:var(--ff-mono);font-size:8px"
            fill="currentColor" stroke="none">h/3</text>
    </g>
  </symbol>

  <!-- 03 Bowls e transições: quarter pipe em corte, h 1200 / R 2100 -->
  <symbol id="dwg-quarter-cota" viewBox="0 0 200 120">
    <g fill="none" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke">
      <path d="M8 100h184" stroke-dasharray="2 6" opacity=".3" />
      <path d="M16 100h14" />
      <path d="M30 100a115.5 115.5 0 0 0 104.3-66" />
      <path d="M134.3 34H184" />
      <circle cx="131.5" cy="37.5" r="3.4" />
      <path d="M30 100V16" stroke-dasharray="4 4" opacity=".55" />
      <path d="M152 100V34M148 100h8M148 34h8" opacity=".65" />
      <text x="35" y="22" style="font-family:var(--ff-mono);font-size:8px"
            fill="currentColor" stroke="none">R 2100</text>
      <text x="157" y="70" style="font-family:var(--ff-mono);font-size:8px"
            fill="currentColor" stroke="none">1200</text>
    </g>
  </symbol>

  <!-- 04 Street: ledge 400 e escada 1200 em corte -->
  <symbol id="dwg-street-cota" viewBox="0 0 200 120">
    <g fill="none" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke">
      <path d="M8 100h184" stroke-dasharray="2 6" opacity=".3" />
      <rect x="18" y="80" width="40" height="20" />
      <path d="M18 84h40" opacity=".45" />
      <path d="M70 100v-15h15v-15h15v-15h15v-15h15" />
      <path d="M130 40h50" />
      <path d="M68 88L132 28" opacity=".8" />
      <path d="M68 92L132 32" opacity=".8" />
      <path d="M10 100V80M7 100h6M7 80h6" opacity=".65" />
      <path d="M146 100V40M142 100h8M142 40h8" opacity=".65" />
      <text x="16" y="74" style="font-family:var(--ff-mono);font-size:8px"
            fill="currentColor" stroke="none">400</text>
      <text x="151" y="72" style="font-family:var(--ff-mono);font-size:8px"
            fill="currentColor" stroke="none">1200</text>
    </g>
  </symbol>

  <!-- 05 Reforma: perfil existente tracejado à esquerda, recuperado à direita -->
  <symbol id="dwg-reforma-cota" viewBox="0 0 200 120">
    <g fill="none" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke">
      <path d="M10 96h180" stroke-dasharray="2 6" opacity=".3" />
      <path d="M10 62h88" stroke-dasharray="5 4" opacity=".55" />
      <path d="M98 62h92" />
      <path d="M10 82h180" opacity=".45" />
      <path d="M10 62v20M190 62v20" opacity=".45" />
      <path d="M42 62l-3 11 4 9M62 62l2 8-3 12" opacity=".8" />
      <path d="M98 54v34" stroke-dasharray="3 3" opacity=".6" />
      <path d="M104 72h78" stroke-dasharray="1 6" opacity=".55" />
      <path d="M150 62v20M146 62h8M146 82h8" opacity=".7" />
      <text x="156" y="76" style="font-family:var(--ff-mono);font-size:8px"
            fill="currentColor" stroke="none">100</text>
    </g>
  </symbol>

  <!-- 06 Consultoria: prancha com marca de revisão e cota conferida -->
  <symbol id="dwg-revisao-cota" viewBox="0 0 200 120">
    <g fill="none" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke">
      <rect x="16" y="12" width="152" height="88" />
      <rect x="22" y="18" width="140" height="76" stroke-dasharray="3 6" opacity=".35" />
      <path d="M112 76h50M112 76v18M112 85h50" opacity=".7" />
      <path d="M34 68h14a26 26 0 0 1 26-26h22" />
      <path d="M48 68V42h26" stroke-dasharray="4 4" opacity=".55" />
      <path d="M92 24l7 12H85z" />
      <text x="89" y="34" style="font-family:var(--ff-mono);font-size:7px"
            fill="currentColor" stroke="none">1</text>
      <path d="M34 80h60M34 76v8M94 76v8" opacity=".7" />
      <text x="40" y="94" style="font-family:var(--ff-mono);font-size:8px"
            fill="currentColor" stroke="none">R 2100</text>
    </g>
  </symbol>

  <!-- Planta grande usada como marca d'água estrutural de seção -->
  <symbol id="blue-park" viewBox="0 0 620 360">
    <g fill="none" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke">
      <rect x="20" y="20" width="580" height="320" />
      <path d="M20 90h580M20 270h580M170 20v320M450 20v320" stroke-dasharray="3 8" opacity=".5" />
      <rect x="60" y="120" width="230" height="140" rx="70" />
      <rect x="86" y="146" width="178" height="88" rx="44" />
      <rect x="112" y="172" width="126" height="36" rx="18" />
      <path d="M330 90h190v26H330zM330 90l24-22h190l-24 22" />
      <path d="M340 170h24v10h24v10h24v10h24v10h30" />
      <path d="M340 170v40h126" />
      <circle cx="470" cy="250" r="52" /><circle cx="470" cy="250" r="30" />
      <path d="M418 250h104M470 198v104" stroke-dasharray="4 4" opacity=".5" />
      <path d="M20 352h580M20 346v12M600 346v12" />
      <path d="M608 20v320M602 20h12M602 340h12" />
    </g>
  </symbol>

</svg>