---
// Biblioteca de desenhos técnicos em SVG.
// Este componente injeta os <symbol> uma única vez no início do <body>.
// Para usar um desenho em qualquer lugar: <Desenho id="dwg-bowl3d" />
//
// Os traços usam vector-effect="non-scaling-stroke", então a linha fica com
// 1px real em qualquer tamanho que o desenho for exibido.
---

<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">

  <!-- 01 · Levantamento topográfico: curvas de nível -->
  <symbol id="dwg-contours" viewBox="0 0 200 120">
    <g fill="none" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke">
      <ellipse cx="98" cy="58" rx="80" ry="41" transform="rotate(-7 98 58)" />
      <ellipse cx="98" cy="58" rx="62" ry="31" transform="rotate(-7 98 58)" />
      <ellipse cx="98" cy="58" rx="44" ry="21" transform="rotate(-7 98 58)" />
      <ellipse cx="98" cy="58" rx="25" ry="11" transform="rotate(-7 98 58)" />
      <path d="M98 44v28M84 58h28" stroke-dasharray="3 3" />
      <path d="M6 112h188" stroke-dasharray="7 5" opacity=".55" />
      <path d="M20 6v10M14 11h12M176 100v10M170 105h12" />
    </g>
  </symbol>

  <!-- 02 · Projeto: planta baixa com bowl, ledges e escada -->
  <symbol id="dwg-plan" viewBox="0 0 200 120">
    <g fill="none" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke">
      <rect x="8" y="8" width="184" height="94" />
      <path d="M8 34h184M8 76h184M62 8v94M132 8v94" stroke-dasharray="2 5" opacity=".45" />
      <rect x="24" y="30" width="82" height="52" rx="26" />
      <rect x="34" y="40" width="62" height="32" rx="16" />
      <path d="M124 22h52M124 22v8h52v-8M124 44h38v7h-38z" />
      <path d="M126 66h10v6h10v6h10v6h10v6h12" />
      <path d="M8 112h184M8 108v8M192 108v8" />
    </g>
  </symbol>

  <!-- 03 · Preparação: corte de escavação com taludes -->
  <symbol id="dwg-earth" viewBox="0 0 200 120">
    <g fill="none" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke">
      <path d="M4 44h48l26 40h44l26-40h48" />
      <path d="M4 44h192" stroke-dasharray="4 4" opacity=".45" />
      <path d="M60 92l8-8M76 100l14-14M96 100l14-14M116 100l12-12M136 96l8-8" />
      <path d="M40 44v-16M36 28h8l-4 6zM160 44V28M156 28h8l-4 6z" />
      <path d="M4 108h192M4 104v8M196 104v8" />
    </g>
  </symbol>

  <!-- 04 · Execução: malha de armação em perspectiva -->
  <symbol id="dwg-rebar" viewBox="0 0 200 120">
    <g fill="none" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke">
      <path d="M10 96L86 30M32 100L108 34M54 104L130 38M76 108L152 42M98 112L174 46" />
      <path d="M10 96L98 112M20 87L108 103M30 78L118 94M40 69L128 85M50 60L138 76M60 51L148 67M70 42L158 58M80 33L168 49" />
      <path d="M86 30L174 46" opacity=".5" />
      <path d="M10 96v10M98 112v6" stroke-dasharray="3 3" opacity=".5" />
    </g>
  </symbol>

  <!-- 05 · Acabamento: detalhe de coping com raio cotado -->
  <symbol id="dwg-coping" viewBox="0 0 200 120">
    <g fill="none" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke">
      <path d="M12 100h44A56 56 0 0 1 112 44V26h76" />
      <path d="M12 110h44A66 66 0 0 1 122 44V36h66" opacity=".55" />
      <circle cx="112" cy="32" r="7" />
      <path d="M56 100L56 44 112 44" stroke-dasharray="4 4" opacity=".6" />
      <path d="M64 108l6-6M80 110l8-8M98 106l7-7" />
      <path d="M130 26h58M130 22v8M188 22v8" opacity=".7" />
    </g>
  </symbol>

  <!-- 06 · Entrega: bowl em perspectiva -->
  <symbol id="dwg-bowl3d" viewBox="0 0 200 120">
    <g fill="none" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke">
      <path d="M40 40h86a48 26 0 0 1 0 52H40a48 26 0 0 1 0-52z" />
      <path d="M56 54h70a30 16 0 0 1 0 32H56a30 16 0 0 1 0-32z" />
      <path d="M40 40l16 14M126 40l-1 14M40 92l16-6M126 92l-1-6" opacity=".7" />
      <path d="M14 30h172" stroke-dasharray="4 4" opacity=".4" />
      <path d="M150 66h32M150 62v8M182 62v8" opacity=".7" />
    </g>
  </symbol>

  <!-- Bowls e transições: corte de quarter pipe com raio -->
  <symbol id="dwg-quarter" viewBox="0 0 200 120">
    <g fill="none" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke">
      <path d="M8 100h48A52 52 0 0 1 108 48V28h84" />
      <path d="M8 110h48A62 62 0 0 1 118 48V38h74" opacity=".55" />
      <circle cx="108" cy="34" r="6" />
      <path d="M56 100V48h52" stroke-dasharray="4 4" opacity=".6" />
      <path d="M8 100h192" stroke-dasharray="2 6" opacity=".35" />
    </g>
  </symbol>

  <!-- Street: escada com corrimão em perspectiva -->
  <symbol id="dwg-stairs" viewBox="0 0 200 120">
    <g fill="none" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke">
      <path d="M14 102h26V88h24V74h24V60h24V46h26" />
      <path d="M14 102V112h124V46" />
      <path d="M28 84L134 30" />
      <path d="M28 84v18M134 30v16" />
      <path d="M80 57v22" opacity=".6" />
      <path d="M150 46h38v20h-38z" opacity=".7" />
      <path d="M150 46l10-8h38l-10 8" opacity=".7" />
    </g>
  </symbol>

  <!-- Concreto: corte da laje com camadas e malha -->
  <symbol id="dwg-slab" viewBox="0 0 200 120">
    <g fill="none" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke">
      <path d="M8 40h184M8 64h184M8 82h184M8 100h184" />
      <path d="M8 40v60M192 40v60" />
      <path d="M20 64l10-10M40 64l10-10M60 64l10-10M80 64l10-10M100 64l10-10M120 64l10-10M140 64l10-10M160 64l10-10" />
      <path d="M8 82h184" stroke-dasharray="4 4" />
      <circle cx="46" cy="52" r="2" /><circle cx="96" cy="52" r="2" /><circle cx="146" cy="52" r="2" />
      <path d="M196 40v24M192 40h8M192 64h8" opacity=".7" />
    </g>
  </symbol>

  <!-- Reforma: perfil existente tracejado e perfil novo cheio -->
  <symbol id="dwg-repair" viewBox="0 0 200 120">
    <g fill="none" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke">
      <path d="M8 92h46a46 46 0 0 1 46-46h92" stroke-dasharray="5 4" opacity=".55" />
      <path d="M8 82h46a54 54 0 0 1 54-54h84" />
      <path d="M62 78l8-8M78 66l8-8M94 54l8-8M112 44l8-8" />
      <path d="M132 28h60M132 24v8M192 24v8" opacity=".7" />
      <path d="M8 104h192" stroke-dasharray="2 6" opacity=".35" />
    </g>
  </symbol>

  <!-- Planta grande usada como marca d'água estrutural de seção -->
  <symbol id="blue-park" viewBox="0 0 620 360">
    <g fill="none" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke">
      <rect x="20" y="20" width="580" height="320" />
      <path d="M20 90h580M20 270h580M170 20v320M450 20v320" stroke-dasharray="3 8" opacity=".5" />
      <rect x="60" y="120" width="230" height="140" rx="70" />
      <rect x="86" y="146" width="178" height="88" rx="44" />
      <rect x="112" y="172" width="126" height="36" rx="18" />
      <path d="M330 90h190v26H330zM330 90l24-22h190l-24 22" />
      <path d="M340 170h24v10h24v10h24v10h24v10h30" />
      <path d="M340 170v40h126" />
      <circle cx="470" cy="250" r="52" /><circle cx="470" cy="250" r="30" />
      <path d="M418 250h104M470 198v104" stroke-dasharray="4 4" opacity=".5" />
      <path d="M20 352h580M20 346v12M600 346v12" />
      <path d="M608 20v320M602 20h12M602 340h12" />
    </g>
  </symbol>

</svg>