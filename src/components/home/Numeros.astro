---
// Números da empresa com o mapa de atuação ao lado.
// Visual de relatório técnico: fios finos separando, nada de faixa colorida.

import Mapa from './Mapa.astro';

const dados = [
  { valor: '18+', titulo: 'Anos', complemento: 'de experiência' },
  { valor: '2.800+', titulo: 'M² de pistas', complemento: 'construídas' },
  { valor: '15+', titulo: 'Obras', complemento: 'entregues' },
  { valor: '5', titulo: 'Estados', complemento: 'atendidos' },
];
---

<section class="sec numeros" id="numeros">
  <div class="numeros-in">
    <div class="coluna-dados rv">
      <span class="eyebrow">Em números</span>

      <div class="figuras">
        {dados.map((d) => (
          <div class="figura">
            <b>{d.valor}</b>
            <span>{d.titulo}<br />{d.complemento}</span>
          </div>
        ))}
      </div>
    </div>

    <div class="coluna-mapa rv rv-d1">
      <span class="mono-sm rotulo-mapa">Onde já construímos</span>
      <Mapa />
    </div>
  </div>
</section>

<style>
  .numeros {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .numeros-in {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(40px, 5vw, 90px);
    align-items: center;
  }

  /* Duas colunas de números, com fio vertical entre elas */
  .figuras {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(32px, 4vw, 56px) 0;
    margin-top: clamp(24px, 3vw, 40px);
  }

  .figura {
    padding-left: clamp(16px, 2.4vw, 40px);
    border-left: 1px solid var(--line);
  }
  .figura:nth-child(odd) { padding-left: 0; border-left: 0 }

  .figura b {
    display: block;
    font-family: var(--ff-display);
    font-weight: 400;
    font-size: clamp(2.8rem, 5.2vw, 5rem);
    line-height: .86;
    color: var(--white);
  }

  .figura span {
    display: block;
    margin-top: 14px;
    font-family: var(--ff-mono);
    font-size: 10px;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--gray-500);
  }

  .coluna-mapa { display: flex; flex-direction: column; align-items: flex-end }
  .rotulo-mapa { margin-bottom: 18px }

  @media (max-width: 980px) {
    .numeros-in { grid-template-columns: 1fr }
    .coluna-mapa { align-items: flex-start; margin-top: 24px }
  }
</style>