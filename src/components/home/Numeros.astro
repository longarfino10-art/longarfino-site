---
// Seção "A Longarfino": números, resumo da história, equipe e um feedback.
// A tira de fotos (Galeria.astro) vem logo em seguida e fecha o bloco.
//
// A história completa fica em /a-longarfino — aqui só o resumo com link.

import { Image } from 'astro:assets';

import fPaulo from '../../assets/equipe/paulo.jpg';
import fLucas from '../../assets/equipe/lucas.jpg';
import fGrazi from '../../assets/equipe/grazi.png';
import fLeandro from '../../assets/equipe/leandro.png';

const ANO_INICIO = 2007;
const anos = new Date().getFullYear() - ANO_INICIO;

const dados = [
  { valor: anos + '+', titulo: 'Anos', complemento: 'de experiência' },
  { valor: '12.360', titulo: 'M² de pistas', complemento: 'construídas' },
  { valor: '15+', titulo: 'Obras', complemento: 'entregues' },
  { valor: '5', titulo: 'Estados', complemento: 'atendidos' },
];

const equipe = [
  { nome: 'Paulo', funcao: 'Proprietário e execução', foto: fPaulo },
  { nome: 'Lucas', funcao: 'TI e administrativo', foto: fLucas },
  { nome: 'Grazi', funcao: 'Administrativo', foto: fGrazi },
  { nome: 'Leandro', funcao: 'Engenheiro civil', foto: fLeandro },
];

// PROVISÓRIO — TEXTO DE EXEMPLO, NÃO PUBLICAR
// Substituir pelo comentário real, copiado do post, com o @ do autor.
const feedback = {
  texto: 'A pista ficou perfeita. As transições e o acabamento fizeram toda a diferença para quem anda.',
  autor: '@exemplo',
  local: 'Florianópolis / SC',
};
---

<section class="sec longarfino" id="numeros">
  <span class="eyebrow rv">Em números</span>

  <div class="figuras rv">
    {dados.map((d) => (
      <div class="figura">
        <b>{d.valor}</b>
        <span>{d.titulo}<br />{d.complemento}</span>
      </div>
    ))}
  </div>

  <div class="meio">
    <div class="historia rv">
      <span class="mono-sm rotulo">Nossa história</span>
      <p class="texto">
        A Longarfino nasceu da paixão pelo skate e da experiência construída
        dentro das pistas. Em 2007, no bairro Restinga, em Porto Alegre,
        Paulo Longarfino começou a construir obstáculos e a organizar eventos
        na comunidade. Daí veio o conhecimento prático de geometria,
        transição e o que uma pista precisa oferecer para quem anda nela.
      </p>
      <p class="frase">De quem viveu o skate para quem vive o skate.</p>

      <a class="btn btn--bare mais" href="/a-longarfino">
        Conhecer a Longarfino <i class="arw"></i>
      </a>
    </div>

    <div class="time rv rv-d1">
      <span class="mono-sm rotulo">Nossa equipe</span>

      <ul class="pessoas">
        {equipe.map((p) => (
          <li class="pessoa">
            <div class="retrato ph">
              <Image src={p.foto} alt={'Retrato de ' + p.nome} widths={[200, 320]} />
            </div>
            <b class="nome">{p.nome}</b>
            <span class="funcao">{p.funcao}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <figure class="dep rv">
    <span class="aspas" aria-hidden="true">"</span>
    <blockquote class="fala">{feedback.texto}</blockquote>
    <figcaption class="autor mono-sm">{feedback.autor} · {feedback.local}</figcaption>
  </figure>
</section>

<style>
  .longarfino {
    border-top: 1px solid var(--line);
    padding-bottom: clamp(28px, 3.4vw, 48px);
  }

  .figuras {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    max-width: 900px;
    margin-bottom: clamp(36px, 4.4vw, 60px);
  }

  .figura {
    padding-inline: clamp(16px, 2.4vw, 42px);
    border-left: 1px solid var(--line);
    white-space: nowrap;
  }
  .figura:first-child { padding-left: 0; border-left: 0 }

  .figura b {
    display: block;
    font-family: var(--ff-display);
    font-weight: 400;
    font-size: clamp(1.8rem, 2.8vw, 2.9rem);
    line-height: .86;
    color: var(--white);
  }

  .figura span {
    display: block;
    margin-top: 12px;
    font-family: var(--ff-mono);
    font-size: 10px;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--gray-500);
  }

  /* História à esquerda, equipe à direita */
  .meio {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(32px, 5vw, 80px);
    padding-top: clamp(28px, 3.4vw, 44px);
    border-top: 1px solid var(--line);
  }

  .rotulo { display: block; margin-bottom: 22px }

  .texto {
    max-width: 46ch;
    font-size: .9375rem;
    line-height: 1.7;
    color: var(--gray-200);
  }

  .frase {
    margin-top: 18px;
    font-family: var(--ff-display);
    font-size: clamp(1.1rem, 1.5vw, 1.45rem);
    line-height: 1.1;
    text-transform: uppercase;
    color: var(--white);
  }

  .mais { margin-top: 24px }

  /* Quatro retratos em fileira, com fio embaixo da foto */
  .pessoas {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(12px, 1.4vw, 22px);
    list-style: none;
  }

  .retrato {
    aspect-ratio: 3 / 4;
    margin-bottom: 12px;
  }

  .retrato img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 22%;
  }

  /* A foto ganha cor quando o mouse passa — mesmo gesto da galeria */
  .pessoa:hover .retrato img {
    filter: grayscale(.15) contrast(1.05) brightness(.98);
    transform: scale(1.03);
  }

  .nome {
    display: block;
    font-family: var(--ff-display);
    font-weight: 400;
    font-size: 1.15rem;
    line-height: 1;
    text-transform: uppercase;
    color: var(--white);
  }

  .funcao {
    display: block;
    margin-top: 6px;
    font-family: var(--ff-mono);
    font-size: 9.5px;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--gray-500);
  }

  /* Depoimento ocupando a largura toda, fechando a seção */
  .dep {
    position: relative;
    max-width: 62ch;
    margin-top: clamp(36px, 4.4vw, 60px);
    padding-top: clamp(26px, 3vw, 40px);
    padding-left: clamp(28px, 3vw, 44px);
    border-top: 1px solid var(--line);
  }

  .aspas {
    position: absolute;
    left: 0;
    top: clamp(20px, 2.4vw, 32px);
    font-family: var(--ff-display);
    font-size: 3rem;
    line-height: 1;
    color: var(--orange);
  }

  .fala {
    font-size: clamp(1.05rem, 1.3vw, 1.3rem);
    line-height: 1.5;
    color: var(--white);
  }

  .autor {
    display: block;
    margin-top: 14px;
    color: var(--orange);
  }

  @media (max-width: 980px) {
    .meio { grid-template-columns: 1fr }
    .time { margin-top: 34px }
  }

  @media (max-width: 620px) {
    .figuras { grid-template-columns: repeat(2, 1fr); gap: 28px 0 }
    .figura:nth-child(3) { padding-left: 0; border-left: 0 }
    .pessoas { grid-template-columns: repeat(2, 1fr); gap: 22px }
  }
</style>