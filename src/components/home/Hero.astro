---
// Primeira tela. A foto entra em duas camadas: colorida embaixo e
// dessaturada por cima, com máscara em degradê — a cor aparece só à
// direita, onde não há texto.
//
// O .hero-palco carrega as duas camadas juntas, para o parallax e a
// inclinação não descolarem a máscara.

import { Image } from 'astro:assets';
// PROVISÓRIA — imagem gerada por IA, só para validar a composição.
// Substituir por fotografia real da Longarfino antes do lançamento.
// A foto real de reserva está em assets/hero-real-bowl.jpg (vertical).
import fotoHero from '../../assets/hero.webp';

// Mesma fonte da seção A Longarfino: o ano se calcula sozinho.
const ANO_INICIO = 2007;
const anos = new Date().getFullYear() - ANO_INICIO;

const numeros = [
  { valor: anos + '+', rotulo: 'Anos de experiência' },
  { valor: '12.360', rotulo: 'M² construídos' },
  { valor: 'Brasil', rotulo: 'Atuação nacional' },
];
---

<section class="hero">
  <div class="hero-fundo">
    <div class="hero-palco" data-inclinar data-parallax>
    <Image
      src={fotoHero}
      alt="Bowl em concreto durante a execução, com coping instalado"
      widths={[900, 1600, 2400]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="hero-foto hero-foto--cor"
    />
    <Image
      src={fotoHero}
      alt=""
      widths={[900, 1600, 2400]}
      sizes="100vw"
      loading="eager"
      class="hero-foto hero-foto--pb"
      aria-hidden="true"
    />
    </div>
  </div>

  <div class="hero-conteudo">
    <span class="eyebrow">Longarfino Skateparks</span>

    <h1 class="d h-hero">
      Do projeto<br />ao concreto<span class="quadrado"></span>
    </h1>

    <p class="lead">
      Projetamos e executamos skateparks, bowls e estruturas para skate em
      diferentes escalas, unindo técnica construtiva e experiência real de pista.
    </p>

    <div class="hero-acoes">
      <a class="btn btn--fill" href="#obras">Ver nossas obras <i class="arw"></i></a>
      <a class="btn" href="#contato">Falar com a equipe <i class="arw"></i></a>
    </div>
  </div>

  <!-- Números como dado técnico, separados por fio vertical. Não são cards. -->
  <div class="hero-numeros rv">
    {numeros.map((n) => (
      <div class="numero">
        <b>{n.valor}</b>
        <span>{n.rotulo}</span>
      </div>
    ))}
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 150px var(--pad) clamp(24px, 3vw, 48px);
    overflow: hidden;
    isolation: isolate;
  }

  .hero-fundo {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;

    /* A perspectiva é o que transforma a rotação em profundidade */
    perspective: 1400px;
  }

  /* O palco carrega as duas camadas juntas, então a máscara não descola.
     Deslocamento vem do parallax, rotação vem do inclinar.js. */
  .hero-palco {
    position: absolute;
    inset: 0;
    transform:
      translate3d(0, var(--desloca-y, 0px), 0)
      rotateX(var(--giro-x, 0deg))
      rotateY(var(--giro-y, 0deg))
      scale(1.18);
    transition: transform .5s cubic-bezier(.16, 1, .3, 1);
    will-change: transform;
  }

  /* Duas camadas da mesma foto: colorida embaixo, dessaturada por cima.
     A de cima some para a direita, então a cor aparece só naquele lado.
     O navegador baixa o arquivo uma vez só. */
  /* A escala de 1.1 dá folga para a foto se deslocar sem mostrar borda */
  .hero-foto {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 58%;
  }

  .hero-foto--cor {
    filter: contrast(1.08) brightness(1) saturate(.95);
  }

  .hero-foto--pb {
    filter: grayscale(1) contrast(1.15) brightness(.78);
    -webkit-mask-image: linear-gradient(100deg, #000 0%, #000 42%, transparent 82%);
    mask-image: linear-gradient(100deg, #000 0%, #000 42%, transparent 82%);
  }

  /* Escurece a esquerda para o texto ter contraste, e o rodapé para os números */
  .hero-fundo::after {
    content: "";
    position: absolute;
    inset: 0;
    /* A ordem importa: a primeira camada fica por cima das demais.
       O topo vem primeiro para o menu ter contraste sobre qualquer foto. */
    background:
      linear-gradient(
        to bottom,
        rgba(10, 10, 10, 1) 0%,
        rgba(10, 10, 10, .95) 8%,
        rgba(10, 10, 10, .6) 16%,
        rgba(10, 10, 10, .25) 24%,
        transparent 32%
      ),
      linear-gradient(
        100deg,
        rgba(10, 10, 10, 1) 0%,
        rgba(10, 10, 10, .96) 26%,
        rgba(10, 10, 10, .5) 58%,
        rgba(10, 10, 10, .2) 100%
      ),
      linear-gradient(to top, rgba(10, 10, 10, .9) 0%, transparent 32%);
  }


  /* Sem max-width: o conteúdo segue a mesma margem do header (--pad) */
  .hero-conteudo {
    width: 100%;
    padding-bottom: clamp(40px, 6vw, 80px);
  }

  .hero h1 {
    margin: 6px 0 26px;
    max-width: 14ch;
    color: var(--white);
  }

  /* Ponto final do título, em laranja */
  .quadrado {
    display: inline-block;
    width: .13em;
    height: .13em;
    margin-left: .06em;
    background: var(--orange);
    vertical-align: baseline;
  }

  .hero-acoes {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 34px;
    margin-top: 34px;
  }

  /* Os fios são desenhados por ::before, para poderem crescer na entrada.
     Fio horizontal: da esquerda para a direita. Verticais: de cima para baixo. */
  .hero-numeros {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    width: 100%;
  }

  .hero-numeros::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--line-2);
    transition: width 2.2s var(--ease);
  }
  .hero-numeros.in::before { width: 100% }

  /* O .rv aqui serve só para disparar o traçado — o conteúdo não desliza */
  .hero-numeros.rv { opacity: 1; transform: none }

  .numero {
    position: relative;
    padding: 26px clamp(18px, 3vw, 44px) 30px;
  }
  .numero:first-child { padding-left: 0 }

  .numero::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 0;
    background: var(--line);
    transition: height 1.6s var(--ease);
  }
  .numero:first-child::before { display: none }

  /* Os verticais entram depois do horizontal, um atrás do outro */
  .hero-numeros.in .numero::before { height: 100% }
  .hero-numeros.in .numero:nth-child(2)::before { transition-delay: 1.1s }
  .hero-numeros.in .numero:nth-child(3)::before { transition-delay: 1.45s }

  .numero b {
    display: block;
    font-family: var(--ff-display);
    font-weight: 400;
    font-size: clamp(2.4rem, 4vw, 3.8rem);
    line-height: .9;
    color: var(--white);
  }

  .numero span {
    display: block;
    margin-top: 8px;
    font-family: var(--ff-mono);
    font-size: 10px;
    letter-spacing: .2em;
    text-transform: uppercase;
    color: var(--gray-500);
  }

  @media (max-width: 860px) {
    .hero { padding-top: 120px }

    .hero-numeros { grid-template-columns: 1fr; border-top: 0 }
    .numero {
      display: flex;
      align-items: baseline;
      gap: 16px;
      padding-inline: 0;
      border-left: 0;
      border-top: 1px solid var(--line);
    }
    .numero span { margin-top: 0 }
  }
</style>