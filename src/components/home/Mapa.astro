---
// Seção "A Longarfino": números da empresa e feedbacks de clientes.
// A tira de fotos (Galeria.astro) vem logo em seguida e fecha o bloco.
//
// O mapa de atuação saiu daqui: os números já dizem "5 estados", e o
// mapa mostrava capitais, não as cidades das obras. O componente
// Mapa.astro segue no projeto, para a página /obras.

const ANO_INICIO = 2007;
const anos = new Date().getFullYear() - ANO_INICIO;

const dados = [
  { valor: anos + '+', titulo: 'Anos', complemento: 'de experiência' },
  { valor: '12.360', titulo: 'M² de pistas', complemento: 'construídas' },
  { valor: '15+', titulo: 'Obras', complemento: 'entregues' },
  { valor: '5', titulo: 'Estados', complemento: 'atendidos' },
];

// PROVISÓRIO — TEXTO DE EXEMPLO, NÃO PUBLICAR
// Estes três não são depoimentos reais: são exemplos com o tamanho e o
// tom do que virá, só para ver o layout funcionando. Precisam ser
// substituídos pelos comentários verdadeiros, copiados dos posts, com
// o @ de quem escreveu.
const feedbacks = [
  {
    texto: 'A pista ficou perfeita. As transições e o acabamento fizeram toda a diferença para quem anda.',
    autor: '@exemplo',
    local: 'Florianópolis / SC',
  },
  {
    texto: 'Entregaram no prazo e o acabamento do concreto ficou liso do jeito que a gente pediu.',
    autor: '@exemplo',
    local: 'Laguna / SC',
  },
  {
    texto: 'Trabalho técnico do começo ao fim. A equipe explicou cada etapa da obra para a comunidade.',
    autor: '@exemplo',
    local: 'Garopaba / SC',
  },
];
---

<section class="sec numeros" id="numeros">
  <span class="eyebrow rv">Em números</span>

  <div class="figuras rv">
    {dados.map((d) => (
      <div class="figura">
        <b>{d.valor}</b>
        <span>{d.titulo}<br />{d.complemento}</span>
      </div>
    ))}
  </div>

  <div class="feed rv rv-d1">
    <span class="mono-sm rotulo">Feedbacks</span>

    <ul class="lista">
      {feedbacks.map((f) => (
        <li class="dep">
          <span class="aspas" aria-hidden="true">"</span>
          <p class="fala">{f.texto}</p>
          <span class="autor mono-sm">{f.autor} · {f.local}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .numeros {
    border-top: 1px solid var(--line);
    padding-bottom: clamp(28px, 3.4vw, 48px);
  }

  /* Fileira de números, separados por fio vertical */
  .figuras {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    max-width: 900px;
    margin-bottom: clamp(36px, 4.4vw, 64px);
  }

  .figura {
    padding-inline: clamp(16px, 2.4vw, 42px);
    border-left: 1px solid var(--line);
    white-space: nowrap;
  }
  .figura:first-child { padding-left: 0; border-left: 0 }

  .figura b {
    display: block;
    font-family: var(--ff-display);
    font-weight: 400;
    font-size: clamp(1.8rem, 2.8vw, 2.9rem);
    line-height: .86;
    color: var(--white);
  }

  .figura span {
    display: block;
    margin-top: 12px;
    font-family: var(--ff-mono);
    font-size: 10px;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--gray-500);
  }

  .feed {
    padding-top: clamp(28px, 3.4vw, 44px);
    border-top: 1px solid var(--line);
  }

  .rotulo { display: block; margin-bottom: 26px }

  /* Três colunas, cada uma separada por fio — mesma lógica dos números */
  .lista {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    list-style: none;
  }

  .dep {
    position: relative;
    padding-inline: clamp(20px, 2.6vw, 44px);
    border-left: 1px solid var(--line);
  }
  .dep:first-child { padding-left: 0; border-left: 0 }

  .aspas {
    display: block;
    margin-bottom: 6px;
    font-family: var(--ff-display);
    font-size: 2.2rem;
    line-height: .6;
    color: var(--orange);
  }

  .fala {
    font-size: .9375rem;
    line-height: 1.6;
    color: var(--gray-200);
  }

  .autor {
    display: block;
    margin-top: 14px;
    color: var(--orange);
  }

  @media (max-width: 860px) {
    .lista { grid-template-columns: 1fr; gap: 28px }
    .dep { padding-left: 0; border-left: 0; padding-top: 22px; border-top: 1px solid var(--line) }
    .dep:first-child { padding-top: 0; border-top: 0 }
  }

  @media (max-width: 620px) {
    .figuras { grid-template-columns: repeat(2, 1fr); gap: 28px 0 }
    .figura:nth-child(3) { padding-left: 0; border-left: 0 }
  }
</style>