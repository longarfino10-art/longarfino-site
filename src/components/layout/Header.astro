---
// Cabeçalho fixo. Começa transparente sobre o hero e ganha fundo ao rolar.
// O menu mobile é um overlay de tela cheia, controlado por src/scripts/menu.js

const links = [
  { texto: 'Obras', href: '/obras' },
  { texto: 'Projetos', href: '/#processo' },
  { texto: 'Serviços', href: '/servicos' },
  { texto: 'A Longarfino', href: '/#empresa' },
  { texto: 'Contato', href: '/contato' },
];
---

<header class="hd" id="hd">
  <a href="/" class="mark" aria-label="Longarfino Skateparks — início">
    <b>LS</b><span>parks</span>
  </a>

  <nav class="nav" aria-label="Principal">
    {links.map((l) => <a href={l.href}>{l.texto}</a>)}
  </nav>

  <a class="btn hd-cta" href="/contato">Solicitar orçamento <i class="arw"></i></a>

  <button
    class="burger"
    id="burger"
    aria-label="Abrir menu"
    aria-expanded="false"
    aria-controls="menu"
  >
    <i></i><i></i>
  </button>
</header>

<div class="menu" id="menu" aria-hidden="true">
  <nav aria-label="Menu">
    <ol>
      {links.map((l, i) => (
        <li>
          <a href={l.href}>
            <em>{String(i + 1).padStart(2, '0')}</em>
            {l.texto}
          </a>
        </li>
      ))}
    </ol>
  </nav>

  <div>
    <a class="btn btn--fill menu-cta" href="/contato">
      Solicitar orçamento <i class="arw"></i>
    </a>
    <p class="mono-sm" style="margin-top:22px">Garopaba — SC / Brasil</p>
  </div>
</div>

<style>
  .hd {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 800;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 22px var(--pad);
    border-bottom: 1px solid transparent;
    transition: background .4s var(--ease), border-color .4s var(--ease), padding .4s var(--ease);
  }

  /* Estado após rolar a página */
  .hd.is-stuck {
    background: rgba(10, 10, 10, .88);
    backdrop-filter: blur(6px);
    border-bottom-color: var(--line);
    padding-block: 14px;
  }

  /* Marca: LS grande com "parks" em mono embaixo de um fio */
  .mark { display: flex; flex-direction: column; line-height: 1; gap: 3px }
  .mark b {
    font-family: var(--ff-display);
    font-weight: 400;
    font-size: 34px;
    letter-spacing: .06em;
    color: var(--white);
  }
  .mark span {
    padding-top: 3px;
    border-top: 1px solid var(--line-2);
    font-family: var(--ff-mono);
    font-size: 9px;
    letter-spacing: .42em;
    color: var(--gray-200);
  }

  .nav { display: flex; gap: clamp(18px, 2.3vw, 38px) }
  .nav a {
    position: relative;
    padding: 6px 0;
    font-family: var(--ff-mono);
    font-size: 11px;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--gray-200);
  }
  .nav a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0;
    height: 1px;
    background: var(--orange);
    transition: width .35s var(--ease);
  }
  .nav a:hover { color: var(--white) }
  .nav a:hover::after { width: 100% }

  .hd-cta { padding: 13px 20px }

  .burger {
    display: none;
    width: 44px;
    height: 44px;
    flex-direction: column;
    justify-content: center;
    align-items: flex-end;
    gap: 6px;
  }
  .burger i {
    display: block;
    width: 24px;
    height: 1px;
    background: var(--white);
    transition: transform .35s var(--ease), width .35s var(--ease);
  }
  .burger i:nth-child(2) { width: 16px }

  /* ─── Menu mobile ─── */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 790;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 120px var(--pad) 48px;
    background: var(--black);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-12px);
    transition: opacity .4s var(--ease), transform .4s var(--ease), visibility .4s;
  }
  .menu.is-open { opacity: 1; visibility: visible; transform: none }

  .menu ol { list-style: none }
  .menu li { border-top: 1px solid var(--line) }
  .menu li:last-child { border-bottom: 1px solid var(--line) }
  .menu a {
    display: flex;
    align-items: baseline;
    gap: 18px;
    padding: 18px 0;
    font-family: var(--ff-display);
    font-size: clamp(2rem, 9vw, 3rem);
    line-height: 1;
    text-transform: uppercase;
  }
  .menu a em {
    font-family: var(--ff-mono);
    font-size: 10px;
    font-style: normal;
    letter-spacing: .2em;
    color: var(--orange);
  }
  .menu-cta { width: 100%; justify-content: space-between }

  /* No mobile some a navegação e o CTA, entra o hambúrguer */
  @media (max-width: 1180px) {
    .nav, .hd-cta { display: none }
    .burger { display: flex }
  }
</style>