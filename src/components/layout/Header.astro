---
// Cabeçalho fixo. Começa transparente sobre o hero e ganha fundo ao rolar.
// O menu mobile é um overlay de tela cheia, controlado por src/scripts/menu.js

// Cada item responde uma pergunta diferente do visitante.
// "Como executamos" carrega o diferencial: a Longarfino põe a mão na obra.
// Enquanto /servicos, /contato e a seção da empresa não existirem como
// página própria, os itens apontam para as âncoras da home.
// A contagem e a faixa de metragem saem da coleção, para não desatualizarem
// quando novas obras forem publicadas.
import { getCollection } from 'astro:content';

const obras = await getCollection('obras');
const areas = obras.map((o) => o.data.area_m2).sort((a, b) => a - b);
const menor = areas[0].toLocaleString('pt-BR');
const maior = areas[areas.length - 1].toLocaleString('pt-BR');

// `apoio` só aparece no menu mobile. No desktop os itens seguem secos.
const links = [
  { texto: 'Obras',           href: '/obras',      apoio: `${obras.length} pistas publicadas, de ${menor} a ${maior} m²` },
  { texto: 'O que fazemos',   href: '/#servicos',  apoio: 'Projeto, concreto, bowl, street, reforma' },
  { texto: 'Nossa diferença', href: '/#diferenca', apoio: 'Traço, espessura e fôrma, abertos' },
  { texto: 'A Longarfino',    href: '/#numeros',   apoio: 'Desde 2007, cinco estados' },
  { texto: 'Contato',         href: '/contato',    apoio: 'Orçamento em até dois dias úteis' },
];
---

<header class="hd" id="hd">
  <a href="/" class="mark" aria-label="Longarfino Skateparks — início">
    <b>LS</b><span>parks</span>
  </a>

  <nav class="nav" aria-label="Principal">
    {links.map((l) => <a href={l.href}>{l.texto}</a>)}
  </nav>

  <a class="btn hd-cta" href="/contato">Solicitar orçamento <i class="arw"></i></a>

  <button
    class="burger"
    id="burger"
    aria-label="Abrir menu"
    aria-expanded="false"
    aria-controls="menu"
  >
    <i></i><i></i>
  </button>
</header>

<div class="menu" id="menu" aria-hidden="true">
  <nav aria-label="Menu">
    <ul>
      {links.map((l) => (
        <li><a href={l.href}>{l.texto}</a></li>
      ))}
    </ul>
  </nav>

  <div class="menu-pe">
    <a class="btn menu-cta" href="/contato">
      Solicitar orçamento <i class="arw"></i>
    </a>
    <p class="mono-sm menu-local">Imbituba — SC / Brasil</p>
  </div>
</div>

<style>
  .hd {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 800;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 22px var(--pad);
    border-bottom: 1px solid transparent;
    transition: background .4s var(--ease), border-color .4s var(--ease), padding .4s var(--ease);
  }
  /* O nav sai do fluxo e se ancora no centro real da tela. Dentro do flex ele
     nunca ficaria centrado, porque o CTA da direita é mais largo que o logo.
     São quatro filhos no header — logo, nav, CTA e burger. */
  .hd > .nav {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
  }

  /* Estado após rolar a página */
  .hd.is-stuck {
    background: rgba(10, 10, 10, .88);
    backdrop-filter: blur(6px);
    border-bottom-color: var(--line);
    padding-block: 14px;
  }

  /* Marca: LS grande com "parks" em mono embaixo de um fio */
  .mark { display: flex; flex-direction: column; line-height: 1; gap: 3px }
  /* O logo leva à home. Sem sinal de hover ninguém descobre. */
  .mark span { transition: border-color .25s var(--ease), color .25s var(--ease) }
  .mark:hover span { border-top-color: var(--orange); color: var(--white) }
  /* Monograma: as letras coladas, quase um bloco só */
  .mark b {
    font-family: var(--ff-display);
    font-weight: 400;
    font-size: 36px;
    letter-spacing: -.01em;
    color: var(--white);
  }

  /* O fio acompanha a largura do LS, não a da palavra "parks" */
  .mark span {
    display: block;
    width: 100%;
    padding-top: 4px;
    border-top: 1px solid var(--line-2);
    font-family: var(--ff-mono);
    font-size: 9px;
    letter-spacing: .34em;
    color: var(--gray-200);
  }

  .nav { display: flex; gap: clamp(14px, 1.8vw, 30px) }
  .nav a {
    position: relative;
    padding: 6px 0;
    font-family: var(--ff-mono);
    font-size: 11px;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--gray-200);
  }
  .nav a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0;
    height: 1px;
    background: var(--orange);
    transition: width .35s var(--ease);
  }
  .nav a:hover { color: var(--white) }
  .nav a:hover::after { width: 100% }

  .hd-cta { padding: 13px 20px }

  .burger {
    display: none;
    width: 44px;
    height: 44px;
    flex-direction: column;
    justify-content: center;
    align-items: flex-end;
    gap: 6px;
  }
  .burger i {
    display: block;
    width: 24px;
    height: 1px;
    background: var(--white);
    transition: transform .35s var(--ease), width .35s var(--ease);
  }
  .burger i:nth-child(2) { width: 16px }

  /* ─── Menu mobile ─── */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 790;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding: 104px var(--pad) 32px;
    /* Fundo translúcido com desfoque: deixa entrever a página atrás,
       sem prejudicar a leitura do menu. */
    background: rgba(10, 10, 10, .92);
    backdrop-filter: blur(18px) saturate(1.1);
    -webkit-backdrop-filter: blur(18px) saturate(1.1);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-12px);
    transition: opacity .4s var(--ease), transform .4s var(--ease), visibility .4s;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .menu.is-open { opacity: 1; visibility: visible; transform: none }

  /* Os itens entram um a um quando o menu abre */
  .menu li {
    opacity: 0;
    transform: translateY(10px);
    transition: opacity .45s var(--ease), transform .45s var(--ease);
  }
  .menu.is-open li { opacity: 1; transform: none }
  .menu.is-open li:nth-child(1) { transition-delay: .06s }
  .menu.is-open li:nth-child(2) { transition-delay: .11s }
  .menu.is-open li:nth-child(3) { transition-delay: .16s }
  .menu.is-open li:nth-child(4) { transition-delay: .21s }
  .menu.is-open li:nth-child(5) { transition-delay: .26s }

  .menu ul { list-style: none; margin: 0; padding: 0 }
  .menu li { border-top: 1px solid var(--line); position: relative }
  .menu li:last-child { border-bottom: 1px solid var(--line) }

  /* O fio laranja corre sob o item tocado, mesmo gesto do menu no desktop. */
  .menu li::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 0;
    height: 1px;
    background: var(--orange);
    transition: width .4s var(--ease);
  }
  .menu li:active::after { width: 100% }

  .menu nav a {
    display: block;
    padding: clamp(15px, 3.4vw, 21px) 0;
    font-family: var(--ff-display);
    font-size: clamp(2rem, 8.5vw, 2.8rem);
    line-height: 1;
    text-transform: uppercase;
    color: var(--white);
    transition: color .3s var(--ease), padding-left .3s var(--ease);
  }
  .menu a:active { color: var(--orange); padding-left: 10px }

  /* O pé sobe junto com a lista em vez de ficar preso no fim da tela —
     era o vão morto entre o último item e o botão. */
  /* Num flex column os filhos esticam na horizontal. Sem isto o botão ocupa
     a largura toda e a seta é empurrada para fora da borda. */
  .menu-pe {
    margin-top: clamp(60px, 19vw, 92px);
    align-items: flex-start;
    display: flex;
    flex-direction: column;
  }
  .menu-pe { animation: menu-pe-sobe .5s var(--ease) .3s both }
  @keyframes menu-pe-sobe {
    from { opacity: 0; transform: translateY(10px) }
    to   { opacity: 1; transform: none }
  }
  .menu:not(.is-open) .menu-pe { animation: none; opacity: 0 }


  /* Sem padding vertical o conteúdo cola no topo e a ponta da seta, que fica
     3px acima do fio, escapa da caixa. */
  .menu-cta {
    gap: 16px;
    padding: 19px 26px;
    font-size: 12.5px;
    letter-spacing: .16em;
  }

  /* A seta do .btn é um bloco de 1px de altura; sem isto ela desalinha
     em relação à linha de base do texto. */
  .menu-cta .arw { align-self: center; margin-top: 0 }

  /* Fio laranja correndo pela base ao toque, mesmo gesto dos itens da lista.
     O ::after fica na borda, por isso o botão precisa ser posicionado. */
  .menu-cta {
    position: relative;
    overflow: hidden;
    transition: color .3s var(--ease), border-color .3s var(--ease);
  }
  /* O fio se traça quando o menu abre, depois dos itens da lista. Não depende
     do toque: no celular o :active dura menos que a animação. */
  .menu-cta::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0;
    height: 2px;
    background: var(--orange);
  }
  .menu.is-open .menu-cta::after {
    animation: cta-fio .55s var(--ease) .42s forwards;
  }
  @keyframes cta-fio {
    from { width: 0 }
    to   { width: 100% }
  }
  .menu-cta:active {
    background: transparent;
    border-color: var(--orange);
    color: var(--white);
  }
  .menu-cta:active .arw { width: 34px }

  /* O endereço fecha o menu, separado por fio — não solto no vazio. */
  .menu-local {
    margin: clamp(20px, 4vw, 28px) 0 0;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    color: var(--gray-500);
  }

  /* No mobile some a navegação e o CTA, entra o hambúrguer */
  @media (max-width: 1180px) {
    .nav, .hd-cta { display: none }
    .burger { display: flex }
  }
</style>